# Maintainer: Alois Deniel
#
# Template for the AUR `omafiles-bin` package. `@VERSION@` and `@SHA256@` are
# filled in by .github/workflows/release.yml, which then pushes the result to
# aur.archlinux.org. It repackages the prebuilt tree the release workflow
# publishes as omafiles-<ver>-x86_64-linux.tar.gz — no Rust toolchain, no
# fifteen-minute gpui build on the user's machine.
#
#   yay -S omafiles-bin

pkgname=omafiles-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Keyboard-first file explorer for Omarchy (prebuilt binary)"
arch=('x86_64')
url="https://github.com/aloisdeniel/omafiles"
license=('MIT')
depends=('git' 'ffmpeg' 'xdg-utils' 'glib2' 'wl-clipboard' 'libxkbcommon-x11' 'libxcb')
provides=('omafiles')
conflicts=('omafiles')
source=("$url/releases/download/v$pkgver/omafiles-$pkgver-x86_64-linux.tar.gz")
sha256sums=('@SHA256@')

package() {
  # The tarball is the installed tree itself: usr/bin, usr/share/...
  cp -a "$srcdir/usr" "$pkgdir/"
}
